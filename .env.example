########################################################################
# Root .env.example — copy to .env and fill in real values
# cp .env.example .env
#
# NOTE: apps/api and apps/web each read their OWN env in production
# (Render for the API, Vercel for the web). This root .env is mainly
# for local dev + docker-compose.
########################################################################

# ---- Database (Neon in prod, local docker Postgres in dev) ----
# Local docker-compose default:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_booking?schema=public"
# Neon example (prod) — use the POOLED connection string for the app:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/hotel_booking?sslmode=require"
# Neon DIRECT (non-pooled) string — used only for migrations:
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/hotel_booking?sslmode=require"

# ---- Auth ----
# Generate each secret with:  openssl rand -hex 32   (JWT_SECRET กับ JWT_REFRESH_SECRET ต้องคนละค่า)
JWT_SECRET="replace-me-with-a-long-random-hex-string"          # access token secret
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="replace-me-with-a-DIFFERENT-long-random-hex-string"   # refresh token secret (คนละค่ากับ JWT_SECRET)
JWT_REFRESH_EXPIRES="7d"

# ---- Redis (distributed lock / TTL) ----
REDIS_URL="redis://localhost:6379"

# ---- API server ----
PORT="3000"
NODE_ENV="development"
# Comma-separated allowed origins for CORS (the web app's URL):
CORS_ORIGINS="http://localhost:3001,http://localhost:5173"
# Cookie domain settings for cross-site auth in prod (leave blank in dev):
COOKIE_DOMAIN=""

# ---- Seed admin (used by prisma seed) ----
SEED_ADMIN_EMAIL="admin@hotel.local"
SEED_ADMIN_PASSWORD="Admin12345"

# ---- Web (Next.js) ----
# Must be prefixed NEXT_PUBLIC_ to be exposed to the browser.
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
