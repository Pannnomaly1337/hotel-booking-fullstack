{
  "name": "hotel-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel Booking System — Next.js + NestJS + Prisma/Postgres monorepo",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "db:generate": "pnpm --filter @repo/api prisma:generate",
    "db:migrate": "pnpm --filter @repo/api prisma:migrate",
    "db:seed": "pnpm --filter @repo/api prisma:seed",
    "db:studio": "pnpm --filter @repo/api prisma:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}
