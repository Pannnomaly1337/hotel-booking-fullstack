// Prisma schema — Postgres (Neon in prod, docker Postgres in dev)
// Migrated from the original Mongoose models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl is the non-pooled Neon connection, used for migrations only.
  // In dev (docker) it can point to the same URL as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  user
  admin
}

enum RoomType {
  Single
  Double
  Twin
}

enum RoomStatus {
  Available
  Occupied
  Reserved
  Cleaning
  Maintenance
}

enum BookingStatus {
  pending
  confirmed
  checked_in
  checked_out
  cancelled
}

model User {
  id        String   @id @default(cuid())
  firstname String
  lastname  String
  imagelink String   @default("#")
  detail    String   @default("#")
  email     String   @unique
  password  String // bcrypt hash — never selected by default in queries
  role      Role     @default(user)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings       Booking[]
  occupiedRooms  Room[]    @relation("RoomCurrentGuest")

  @@map("users")
}

model Room {
  id          String     @id @default(cuid())
  roomNumber  Int        @unique
  type        RoomType
  status      RoomStatus @default(Available)
  floor       Int
  roomRate    Float
  imagelink   String?
  notes       String?
  size        String?
  additional1 String?
  additional2 String?
  additional3 String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // The guest currently assigned to the room (nullable)
  currentGuestId String?
  currentGuest   User?   @relation("RoomCurrentGuest", fields: [currentGuestId], references: [id], onDelete: SetNull)

  bookings Booking[]

  @@index([status])
  @@map("rooms")
}

model Booking {
  id                 String        @id @default(cuid())
  confirmationNumber String        @unique
  checkInDate        DateTime
  checkOutDate       DateTime
  nights             Int
  firstname          String
  lastname           String
  email              String
  phone              String
  specialRequest     String?
  // pricing (flattened from the embedded Mongo sub-document)
  roomRate           Float
  totalAmount        Float
  status             BookingStatus @default(pending)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roomId])
  @@index([status])
  @@map("bookings")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}
